# Supabase: create a project at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback if this project does not have API keys enabled yet:
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
# Legacy fallback if this project does not have API keys enabled yet:
SUPABASE_SERVICE_ROLE_KEY=

# Stripe: start in TEST mode; never expose secret keys in NEXT_PUBLIC variables
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_ENABLE_CHECKOUT=false
NEXT_PUBLIC_SITE_URL=

# Promptly Pro essay evaluation (server-only; never prefix this key with NEXT_PUBLIC_)
OPENAI_API_KEY=
PROMPTLY_ESSAY_MODEL=gpt-4o-mini
# Enables essay access for authenticated admins only when no paid Pro subscription exists.
PROMPTLY_ESSAY_ADMIN_TEST_ENABLED=false

# Optional: use a Stripe Customer Portal configuration for self-service billing
